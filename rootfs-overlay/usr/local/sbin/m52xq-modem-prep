#!/bin/sh
# m52xq (Sailfish): adapted from moWerk/sailfishos-pro1x-mainline qx1050-modem-prep.sh (9e815b5); the qx1050 voice-domain
# helper (step 4) is left out for now; SIM slot 1 only (DSDS SIM2 later).
# Modem preparation before ofono (qrtrqmi driver, upstream ofono >= 2.9):
# 1. The modem firmware (MPSS.HA.1.1) does not keep the UIM primary GW provisioning session;
#    without it the SIM stays "detected" and nothing registers. Activate it for the first
#    USIM application on slot 1, every boot, idempotently (postmarketOS msm-modem-uim-selection
#    does the same). Needs qmicli (libqmi-utils).
# 2. ofono's udevng builds the qrtrsoc modem only when rmnet_ipa0 and three rmnet_dataN links
#    exist (plugins/udevng.c setup_qrtrsoc: premux_count >= 3, mux_id = N + 1). The IPA
#    offloads MAPv4 checksums (device/feature/*_offload), so the links need the matching rmnet
#    flags as ModemManager sets them; iproute2 has no rmnet flags option, qmicli does.
# 3. The modem sometimes crashes once during boot ("DOG detects stalled initialization",
#    notes/modem-dog-crash.md) and announces UIM only after its recovery, 90-100 s in. So
#    the wait is long, and afterwards a watch loop prepares the modem again and restarts
#    ofono whenever UIM disappears and comes back (a modem restart drops the session and
#    the links; an ofono started on an unprepared modem hangs, and lipstick with it).
# 4. Voice over the circuit-switched network. With its MCFG files (qx1050-modem-pr) the modem
#    selects the SIM's carrier profile, e.g. Germany-VoLTE-Vodafone with voice domain
#    "ps-preferred": the network then routes incoming calls to VoLTE, which this port has no
#    IMS stack for, and the caller hears "not available" until an outgoing call has made the
#    phone register for circuit-switched voice. cs-preferred keeps incoming calls working
#    (tested 2026-10-30, awake and suspended). qmicli cannot set it: qx1050-voice-domain.py.
# 5. The GNSS engine comes up locked for injected data (GET ENGINE LOCK: lock-client mask 1):
#    fixes work, but time and XTRA injection are refused (notes/gnss.md, 2026-11-08). Unlock
#    it as Android's location HAL does; the EFS is writable, so this is a no-op once stored.
# 6. qrtr modem wake (kernel 0066, from the Guix port): data for user space from the modem
#    wakes the system, filtered to the source ports in /sys/module/qrtr/parameters/wake_ports.
#    Only the voice (9) and messaging (5) services, so network indications do not wake it;
#    their ports come from the name service and can change with a modem restart.
log() { echo "m52xq-modem-prep: $*"; }
uim() { qrtr-lookup 2>/dev/null | awk '$1 == 11 { f = 1 } END { exit !f }'; }

prep() {
  i=0
  while ! qmicli -d qrtr://0 --uim-get-card-status 2>/dev/null | grep -q "Card state: 'present'" && [ $i -lt 20 ]; do i=$((i + 1)); sleep 1; done
  status=$(qmicli -d qrtr://0 --uim-get-card-status 2>/dev/null)
  if echo "$status" | grep -q "Primary GW:.*session doesn't exist"; then
    aid=$(echo "$status" | awk '/Application type:.*usim/ { f = 1 } f && /Application ID:/ { getline; gsub(/[^0-9A-Fa-f]/, ""); print; exit }')
    if [ -n "$aid" ]; then
      qmicli -d qrtr://0 --uim-change-provisioning-session="session-type=primary-gw-provisioning,activate=yes,slot=1,aid=$aid" >/dev/null 2>&1 \
        && log "primary GW provisioning session activated" || log "provisioning activation failed"
    else
      log "no USIM application found"
    fi
  else
    log "primary GW provisioning session present"
  fi
  i=0
  while [ ! -e /sys/class/net/rmnet_ipa0 ] && [ $i -lt 120 ]; do i=$((i + 1)); sleep 1; done
  [ -e /sys/class/net/rmnet_ipa0 ] || { log "no rmnet_ipa0"; return 1; }
  ip link set rmnet_ipa0 up
  # M52XQ: the IPA 4.11 of the SM7325 offloads MAPv5 checksums (pro1x: MAPv4); without the flags no downlink arrives
  flags=
  v=$(sed -n 's/^MAPv\([45]\).*/\1/p' /sys/class/net/rmnet_ipa0/device/feature/rx_offload 2>/dev/null)
  [ -n "$v" ] && flags="ingress-map-cksumv$v"
  v=$(sed -n 's/^MAPv\([45]\).*/\1/p' /sys/class/net/rmnet_ipa0/device/feature/tx_offload 2>/dev/null)
  [ -n "$v" ] && flags="${flags:+$flags|}egress-map-cksumv$v"
  # 0-2 = SIM 1, 3-5 = SIM 2 (ofono patch 0029: the mux ids of the two subscriptions must differ)
  for n in 0 1 2 3 4 5; do
    [ -e /sys/class/net/rmnet_data$n ] && continue
    qmicli -d qrtr://0 --link-add="iface=rmnet_ipa0,prefix=rmnet_data,mux-id=$((n + 1))${flags:+,flags=$flags}" >/dev/null 2>&1 \
      || ip link add link rmnet_ipa0 name rmnet_data$n type rmnet mux_id $((n + 1))
  done
  log "rmnet links ready"
  # cs-preferred keeps incoming calls ringing by CS fallback. With the IMS data daemon running
  # (VoLTE, qx1050-imsd) the modem must be at ps-preferred to ask for IMS.
  qmicli -d qrtr://0 --loc-set-engine-lock=none >/dev/null 2>&1 \
    && log "GNSS engine unlocked" || log "GNSS engine unlock failed"
  p=/sys/module/qrtr/parameters/wake_ports
  if [ -w $p ]; then
    ports=$(qrtr-lookup 2>/dev/null | awk '$4 == 0 && ($1 == 9 || $1 == 5) { printf "%s%s", sep, $5; sep = "," }')
    [ -n "$ports" ] && echo "$ports" > $p && log "modem wake ports: $ports"
  fi
}

i=0
while ! uim && [ $i -lt 300 ]; do i=$((i + 1)); sleep 1; done
uim || log "no UIM service on QRTR after 300 s"
uim && prep
# 7. ofono is started by the boot (network.target.wants) before the links above exist (this unit is Type=simple, After= does not
#    wait for it). rmnet_ipa0 is announced first, ofono checks the modem after 1 s, finds no rmnet_data and forgets it; the links
#    come later without rmnet_ipa0 -> no modem at all ("no SIM"). So: ofono without modems after the links are ready is restarted.
modems() { dbus-send --system --print-reply=literal --dest=org.ofono / org.ofono.Manager.GetModems 2>/dev/null | grep -q qrtrsoc; }
if uim && [ "$(systemctl is-active ofono.service)" = active ]; then
  i=0
  while ! modems && [ $i -lt 5 ]; do i=$((i + 1)); sleep 1; done
  if modems; then
    log "ofono has its modems"
  else
    log "ofono has no modems: restarting it"
    systemctl --no-block restart ofono.service
  fi
else
  systemctl --no-block start ofono.service
fi

up=1
while :; do
  sleep 5
  if uim; then
    if [ $up = 0 ]; then
      log "modem back: preparing again, restarting ofono"
      prep
      systemctl restart ofono.service
      up=1
    fi
  else
    [ $up = 1 ] && log "modem down (no UIM service)"
    up=0
  fi
done
