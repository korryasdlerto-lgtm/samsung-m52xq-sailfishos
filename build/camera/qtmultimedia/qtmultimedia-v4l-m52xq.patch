+/* m52xq: exposure at its maximum and a high analogue gain = a dark scene (main camera only; measured: 767..950 in a dim room) */
+bool CameraBinFlash::darkScene() const
+{
+    if (!m_session->device().contains(QLatin1String("s5kgw3")))
+        return false;
+    const QDir dir(QStringLiteral("/sys/class/video4linux"));
+    for (const QString &node : dir.entryList(QStringList(QStringLiteral("v4l-subdev*")))) {
+        QFile name(dir.filePath(node + QStringLiteral("/name")));
+        if (!name.open(QIODevice::ReadOnly) || !QString::fromLatin1(name.readAll()).startsWith(QLatin1String("s5kgw3")))
+            continue;
+        const int fd = ::open(QFile::encodeName(QStringLiteral("/dev/") + node).constData(), O_RDONLY | O_CLOEXEC);
+        if (fd < 0)
+            return false;
+        struct v4l2_control gain = { V4L2_CID_ANALOGUE_GAIN, 0 };
+        const bool ok = ioctl(fd, VIDIOC_G_CTRL, &gain) == 0;
+        ::close(fd);
+        return ok && gain.value >= 600;                 // 64 = 1x
+    }
+    return false;
+}
