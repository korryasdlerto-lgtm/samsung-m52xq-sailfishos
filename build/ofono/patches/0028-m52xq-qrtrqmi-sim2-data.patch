+/* WDS: the subscription is a 32 bit value, 1 = primary, 2 = secondary */
+static void bind_wds(struct qrtrqmi_data *data, struct qmi_service *service)
+{
+	struct qmi_param *param;
+
+	if (!service)
+		return;
+
+	param = qmi_param_new_uint32(QMI_BIND_PARAM_SUBSCRIPTION,
+					data->subscription + 1);
+
+	if (!qmi_service_send(service, QMI_WDS_BIND_SUBSCRIPTION, param,
+				bind_subscription_cb, (void *) "WDS", NULL))
+		qmi_param_free(param);
+}
+
 /*
  * Bind the shared NAS, VOICE and WMS clients of this node to the
  * subscription before any atom uses them (requests on a client are sent in
@@ -398,6 +418,8 @@
 				QMI_VOICE_BIND_SUBSCRIPTION, "VOICE");
 	data->bind_wms = bind_subscription(data, QMI_SERVICE_WMS,
 				QMI_WMS_BIND_SUBSCRIPTION, "WMS");
+	data->bind_wds = qmi_qrtr_node_get_service(data->node, QMI_SERVICE_WDS);
+	bind_wds(data, data->bind_wds);
 }
 
