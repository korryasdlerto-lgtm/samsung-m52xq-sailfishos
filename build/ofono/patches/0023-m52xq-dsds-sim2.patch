+static void bind_subscription_cb(struct qmi_result *result, void *user_data)
+{
+	const char *what = user_data;
+	uint16_t error;
+
+	if (qmi_result_set_error(result, &error))
+		ofono_warn("%s bind subscription failed: %d", what, error);
+	else
+		DBG("%s bind subscription done", what);
+}
+
+static struct qmi_service *bind_subscription(struct qrtrqmi_data *data,
+				uint32_t type, uint16_t message,
+				const char *what)
+{
+	struct qmi_service *service;
+	struct qmi_param *param;
+
+	service = qmi_qrtr_node_get_service(data->node, type);
+	if (!service)
+		return NULL;
+
+	param = qmi_param_new_uint8(QMI_BIND_PARAM_SUBSCRIPTION,
+					data->subscription);
+
+	if (!qmi_service_send(service, message, param,
+				bind_subscription_cb, (void *) what, NULL))
+		qmi_param_free(param);
+
+	return service;
+}
+
+/*
+ * Bind the shared NAS, VOICE and WMS clients of this node to the
+ * subscription before any atom uses them (requests on a client are sent in
+ * order, so the atoms' first requests already see the binding).
+ */
+static void bind_subscriptions(struct qrtrqmi_data *data)
+{
+	DBG("subscription %d", data->subscription);
+
+	data->bind_nas = bind_subscription(data, QMI_SERVICE_NAS,
+				QMI_NAS_BIND_SUBSCRIPTION, "NAS");
+	data->bind_voice = bind_subscription(data, QMI_SERVICE_VOICE,
+				QMI_VOICE_BIND_SUBSCRIPTION, "VOICE");
+	data->bind_wms = bind_subscription(data, QMI_SERVICE_WMS,
+				QMI_WMS_BIND_SUBSCRIPTION, "WMS");
+}
+
+/* Second modem for SIM 2, created once the first one is powered */
+static void qrtrqmi_create_sub1(struct ofono_modem *modem)
+{
+	static const char *strings[] = {
+		"NetworkInterfaceKernelDriver", "NetworkInterface", "Bus",
+	};
+	struct ofono_modem *sub1;
+	char *name;
+	unsigned int i;
+
+	if (qrtrqmi_sub1_modem)
+		return;
+
+	name = l_strdup_printf("%s", ofono_modem_get_path(modem) + 1);
+	if (l_str_has_suffix(name, "_0"))
+		name[strlen(name) - 1] = '1';
+	else {
+		char *n = l_strdup_printf("%s_1", name);
+
+		l_free(name);
+		name = n;
+	}
+
+	sub1 = ofono_modem_create(name, "qrtrqmi");
+	l_free(name);
+	if (!sub1) {
+		ofono_error("Unable to create the SIM 2 modem");
+		return;
+	}
+
+	for (i = 0; i < L_ARRAY_SIZE(strings); i++)
+		ofono_modem_set_string(sub1, strings[i],
+				ofono_modem_get_string(modem, strings[i]));
+
+	ofono_modem_set_integer(sub1, "NetworkInterfaceIndex",
+			ofono_modem_get_integer(modem,
+					"NetworkInterfaceIndex"));
+	ofono_modem_set_integer(sub1, "Subscription", 1);
+	ofono_modem_set_powered_timeout_hint(sub1, 30);
+
+	if (ofono_modem_register(sub1) < 0) {
+		ofono_error("Unable to register the SIM 2 modem");
+		ofono_modem_remove(sub1);
+		return;
+	}
+
+	qrtrqmi_sub1_modem = sub1;
+	DBG("SIM 2 modem %s", ofono_modem_get_path(sub1));
+}
