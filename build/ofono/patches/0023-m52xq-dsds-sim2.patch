 /*
+ * M52XQ DSDS: the SoC modem has two subscriptions (SIM 1, SIM 2) behind the
+ * same QRTR node. The udev modem (subscription 0) creates a second ofono
+ * modem for subscription 1; each modem has its own QMI clients, bound to its
+ * subscription (NAS, VOICE, WMS Bind Subscription), and its own UIM session
+ * (primary / secondary GW provisioning). The data path (IPA, gprs, lte)
+ * stays with the first modem.
+ */
+#define QRTRQMI_MAX_SUBS		2
+#define QMI_NAS_BIND_SUBSCRIPTION	0x0045
+#define QMI_VOICE_BIND_SUBSCRIPTION	0x0044
+#define QMI_WMS_BIND_SUBSCRIPTION	0x004c
+#define QMI_BIND_PARAM_SUBSCRIPTION	0x01
+
+static struct ofono_modem *qrtrqmi_sub1_modem;
+
