From: Asdlerto Korry <korryasdlerto@gmail.com>
Subject: [PATCH] m52xq: ipa: AgcMSV: one correction at a time, hold until the statistics show it

---
--- a/src/ipa/libipa/agc_msv.cpp	2026-11-24 02:14:00.538397578 +0200
+++ b/src/ipa/libipa/agc_msv.cpp	2026-11-24 02:14:00.558397798 +0200
@@ -105,41 +105,24 @@
 static constexpr float kExposureSatisfactory = 0.2;
 
 /*
- * Proportional gain for exposure/gain adjustment. Maps the MSV error to a
- * multiplicative correction factor:
+ * m52xq: the statistics reach this algorithm many frames after a new exposure
+ * was requested: sensor control delays (unknown for the sensors that end up
+ * here) plus the frames queued in front of the software ISP. Recomputing from
+ * the delayed sensor values on every frame keeps old values going round for
+ * ever (gain 955/950 at 7 Hz on s5kgw3), and with a big difference between them
+ * the picture flickers. So: one correction at a time, then the result is held
+ * until the statistics show it; within the hysteresis the last request stays.
  *
- *   factor = 1.0 + kExpProportionalGain * error
- *
- * With kExpProportionalGain = 0.04:
- *   - max error ~2.5 -> factor 1.10 (~10% step, same as before)
- *   - error 1.0      -> factor 1.04 (~4% step)
- *   - error 0.3      -> factor 1.012 (~1.2% step)
- *
- * This replaces the fixed 10% bang-bang step with a proportional correction
- * that converges smoothly and avoids overshooting near the target.
+ * The statistics are linear and MSV is about 0.5 + 5 * mean, so the factor
+ * needed is (kExposureOptimal - 0.5) / (MSV - 0.5), slightly damped. Big
+ * corrections are made at once, small ones spread over kExpRampFrames.
  */
-static constexpr float kExpProportionalGain = 0.04;
-
-/*
- * Maximum multiplicative step per frame, to bound the correction when the
- * scene changes dramatically.
- */
-static constexpr float kExpMaxStep = 0.15;
-
-/*
- * m52xq: far from the target (|error| above kExpBoostError) one big step of
- * 2^error (clamped to [kExpBoostMin, kExpBoostMax]) on the exposure * gain
- * product, then kExpBoostHold frames without a new step: the statistics of
- * those frames still come from the old exposure (sensor control delays), a new
- * step from them would overshoot. With the 10 % proportional step alone a
- * camera opened in a dark room (exposure at the default, gain at the minimum)
- * needed several seconds to get out of the dark (main s5kgw3, front imx616,
- * macro gc5035 have no sensor helper and use this algorithm).
- */
-static constexpr float kExpBoostError = 0.6;
-static constexpr float kExpBoostMin = 0.25;
-static constexpr float kExpBoostMax = 2.5;
-static constexpr unsigned int kExpBoostHold = 2;
+static constexpr float kExpDamping = 0.85;
+static constexpr float kExpFactorMin = 0.25;
+static constexpr float kExpFactorMax = 2.5;
+static constexpr float kExpRampError = 0.6;
+static constexpr unsigned int kExpRampFrames = 4;
+static constexpr unsigned int kExpHoldFrames = 8;
 
 std::optional<float> calculateMSV(const Histogram &histogram)
 {
@@ -186,59 +169,77 @@
  */
 AgcMSV::Result AgcMSV::calculateNewEv(const Params &params)
 {
-	AgcMSV::Result result = { params.exposure, params.gain };
+	if (!last_)
+		last_ = clampResult({ params.exposure, params.gain });
 
-	if (auto exposureMSV = calculateMSV(params.yHist)) {
-		float error = kExposureOptimal - *exposureMSV;
+	/* A correction is being made, or the statistics do not show it yet. */
+	if (ramp_ > 0) {
+		ramp_--;
+		last_ = applyFactor(*last_, rampFactor_);
+		return *last_;
+	}
 
-		if (std::abs(error) > kExpBoostError) {
-			if (boostHold_ > 0) {
-				boostHold_--;
-				return boostResult_;
-			}
-
-			result = boostExposure(params.exposure, params.gain, error);
-			result.exposure = std::clamp(result.exposure, limits_.exposure[0], limits_.exposure[1]);
-			result.analogueGain = std::clamp(result.analogueGain, limits_.gain[0], limits_.gain[1]);
-			boostResult_ = result;
-			boostHold_ = kExpBoostHold;
-
-			LOG(AgcMSV, Debug)
-				<< "boost error:" << error
-				<< " exposure:" << result.exposure
-				<< " analogue-gain:" << result.analogueGain;
+	if (hold_ > 0) {
+		hold_--;
+		last_ = clampResult(*last_);
+		return *last_;
+	}
 
-			return result;
-		}
+	last_ = clampResult(*last_);
 
-		boostHold_ = 0;
-		result = updateExposure(params.exposure, params.gain, *exposureMSV);
-	} else {
+	auto exposureMSV = calculateMSV(params.yHist);
+	if (!exposureMSV) {
 		LOG(AgcMSV, Debug)
 			<< "Not adjusting exposure due to insufficient histogram data";
+		return *last_;
 	}
 
-	result.exposure = std::clamp(result.exposure, limits_.exposure[0], limits_.exposure[1]);
-	result.analogueGain = std::clamp(result.analogueGain, limits_.gain[0], limits_.gain[1]);
+	const float error = kExposureOptimal - *exposureMSV;
+	if (std::abs(error) <= kExposureSatisfactory)
+		return *last_;
+
+	const float mean = std::max(*exposureMSV - 0.5f, 0.1f);
+	const float factor = std::clamp(std::pow((kExposureOptimal - 0.5f) / mean, kExpDamping),
+					kExpFactorMin, kExpFactorMax);
+
+	if (std::abs(error) > kExpRampError) {
+		last_ = applyFactor(*last_, factor);
+	} else {
+		ramp_ = kExpRampFrames - 1;
+		rampFactor_ = std::pow(factor, 1.0f / kExpRampFrames);
+		last_ = applyFactor(*last_, rampFactor_);
+	}
+	hold_ = kExpHoldFrames;
 
 	LOG(AgcMSV, Debug)
-		<< "exposure:" << result.exposure
-		<< " analogue-gain:" << result.analogueGain;
+		<< "exposureMSV:" << *exposureMSV << " error:" << error
+		<< " factor:" << factor
+		<< " exposure:" << last_->exposure
+		<< " analogue-gain:" << last_->analogueGain;
+
+	return *last_;
+}
 
-	return result;
+AgcMSV::Result AgcMSV::clampResult(const Result &value) const
+{
+	return {
+		std::clamp(value.exposure, limits_.exposure[0], limits_.exposure[1]),
+		std::clamp(value.analogueGain, limits_.gain[0], limits_.gain[1]),
+	};
 }
 
-AgcMSV::Result AgcMSV::boostExposure(uint32_t exposure, double again, float error)
+AgcMSV::Result AgcMSV::applyFactor(const Result &value, double factor) const
 {
-	float factor = std::clamp(std::pow(2.0f, error), kExpBoostMin, kExpBoostMax);
+	uint32_t exposure = std::max<uint32_t>(value.exposure, 1);
+	double again = value.analogueGain;
 
-	if (factor > 1.0f) {
+	if (factor > 1.0) {
 		/* Too dark: exposure first, the rest of the factor on the gain. */
 		uint32_t next = std::min<uint32_t>(std::max<uint32_t>(exposure * factor, exposure + 1),
 						   std::max(limits_.exposure[1], exposure));
-		double rest = exposure ? factor * exposure / next : factor;
+		double rest = factor * exposure / next;
 		if (rest > 1.0)
-			again = again * rest;
+			again = std::max(again * rest, again + limits_.gainMinStep * (next == exposure));
 		exposure = next;
 	} else {
 		/* Too bright: gain first (down to gain1), the rest on the exposure. */
@@ -250,50 +251,7 @@
 			exposure = std::max<uint32_t>(exposure * rest, 1);
 	}
 
-	return { exposure, again };
-}
-
-AgcMSV::Result AgcMSV::updateExposure(uint32_t exposure, double again, float exposureMSV)
-{
-	float error = kExposureOptimal - exposureMSV;
-
-	LOG(AgcMSV, Debug)
-		<< "exposureMSV:" << exposureMSV << " error:" << error;
-
-	if (std::abs(error) > kExposureSatisfactory) {
-		/*
-		 * Compute a proportional correction factor. The sign of the error
-		 * determines the direction: positive error means too dark (increase),
-		 * negative means too bright (decrease).
-		 */
-		float step = std::clamp(error * kExpProportionalGain,
-					-kExpMaxStep, kExpMaxStep);
-		float factor = 1.0f + step;
-
-		LOG(AgcMSV, Debug) << "factor:" << factor;
-
-		if (factor > 1.0f) {
-			/* Scene too dark: increase exposure first, then gain. */
-			if (exposure < limits_.exposure[1]) {
-				uint32_t next = exposure * factor;
-				exposure = std::max(next, exposure + 1);
-			} else {
-				double next = again * factor;
-				again = std::max(next, again + limits_.gainMinStep);
-			}
-		} else {
-			/* Scene too bright: decrease gain first, then exposure. */
-			if (again > std::max(limits_.gain1, limits_.gain[0])) {
-				double next = again * factor;
-				again = std::min(next, again - limits_.gainMinStep);
-			} else {
-				uint32_t next = exposure * factor;
-				exposure = std::min(next, exposure - 1);
-			}
-		}
-	}
-
-	return { exposure, again };
+	return clampResult({ exposure, again });
 }
 
 } /* namespace ipa */
--- a/src/ipa/libipa/agc_msv.h	2026-11-24 02:14:00.538397578 +0200
+++ b/src/ipa/libipa/agc_msv.h	2026-11-24 02:14:00.558397798 +0200
@@ -8,6 +8,7 @@
 #pragma once
 
 #include <array>
+#include <optional>
 #include <stdint.h>
 
 namespace libcamera {
@@ -41,13 +42,15 @@
 	[[nodiscard]] Result calculateNewEv(const Params &params);
 
 private:
-	AgcMSV::Result updateExposure(uint32_t exposure, double again, float exposureMSV);
-	AgcMSV::Result boostExposure(uint32_t exposure, double again, float error);
+	Result clampResult(const Result &value) const;
+	Result applyFactor(const Result &value, double factor) const;
 
 	Limits limits_ = {};
-	/* m52xq: big steps far from the target, held while the sensor applies them */
-	unsigned int boostHold_ = 0;
-	Result boostResult_ = {};
+	/* m52xq: the last request, held until the statistics show it */
+	std::optional<Result> last_;
+	double rampFactor_ = 1.0;
+	unsigned int ramp_ = 0;
+	unsigned int hold_ = 0;
 };
 
 } /* namespace ipa */
