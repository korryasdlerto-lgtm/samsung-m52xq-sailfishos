+	eGLImage *getCachedOutputUVFrameBuffer(FrameBuffer *output);
 
 	/* Pointer to object representing input texture */
 	std::deque<std::pair<SharedFD, std::unique_ptr<eGLImage>>> eglImageInCache_;
