+    m_rawCaptured = false;
+    m_rawProcess = new QProcess(this);
+    m_rawProcess->setProcessChannelMode(QProcess::SeparateChannels);
+    updateState();
+    m_session->beginRawPhoto();
+
+    connect(m_rawProcess, &QProcess::readyReadStandardOutput, this, [this, id]() {
+        if (!m_rawCaptured && m_rawProcess->readAllStandardOutput().contains("M52XQ_CAPTURED")) {
+            m_rawCaptured = true;
+            emit imageExposed(id);
+            m_session->endRawPhoto();
+        }
+    });
+    connect(m_rawProcess, static_cast<void (QProcess::*)(int, QProcess::ExitStatus)>(&QProcess::finished), this,
+            [this, id, file, part](int code, QProcess::ExitStatus status) {
+        const QByteArray log = m_rawProcess->readAllStandardError().trimmed();
+        m_rawProcess->deleteLater();
+        m_rawProcess = 0;
+        flashOff();
+        m_session->endRawPhoto();       // when the capture itself failed
+        if (status == QProcess::NormalExit && code == 0 && QFile::exists(part) && QFile::rename(part, file)) {
+            emit imageSaved(id, file);
+        } else {
+            QFile::remove(part);
+            qWarning() << "m52xq-rawphoto failed:" << code << log.right(300);
+            emit error(id, QCameraImageCapture::ResourceError, tr("Camera error"));
+        }
+        updateState();
+    });
+    connect(m_rawProcess, &QProcess::errorOccurred, this, [this, id](QProcess::ProcessError e) {
+        if (e == QProcess::FailedToStart && m_rawProcess) {
