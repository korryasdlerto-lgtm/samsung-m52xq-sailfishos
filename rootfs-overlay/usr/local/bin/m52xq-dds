#!/usr/bin/env python3
# m52xq (Sailfish): the data SIM (DDS, designated data subscription) of the dual-SIM modem, through its DSD service (QMI
# service 42, message ids found on 23.10 -- not in libqmi): 0x004F Get Current DDS (TLV 0x10 u32), 0x004E Switch DDS
# (TLV 0x01 u32), 1 = SIM1, 2 = SIM2. The modem sends indication 0x004E when the switch is done.
# Port of the pmOS m52xq-dds: Python 3.8 of Sailfish 5.2 has no AF_QIPCRTR addresses ("getsockaddrlen: bad family"), so
# getsockname/sendto/recvfrom of the QRTR socket go through libc (ctypes).
#   m52xq-dds get        prints 1 or 2
#   m52xq-dds set 1|2    switches and waits until the modem reports it (exit 1 if it did not within 10 s)
import ctypes
import select
import socket
import struct
import sys
import time

AF_QIPCRTR = 42
DSD = 42
QRTR_PORT_CTRL = 0xfffffffe
libc = ctypes.CDLL(None, use_errno=True)


class SockaddrQrtr(ctypes.Structure):
    _fields_ = [('sq_family', ctypes.c_ushort), ('sq_node', ctypes.c_uint32), ('sq_port', ctypes.c_uint32)]


def parse_tlvs(b):
    out, i = {}, 0
    while i + 3 <= len(b):
        t, ln = struct.unpack_from('<BH', b, i)
        out[t] = b[i + 3:i + 3 + ln]
        i += 3 + ln
    return out


class Dsd:
    def __init__(self):
        self.s = socket.socket(AF_QIPCRTR, socket.SOCK_DGRAM)
        self.fd = self.s.fileno()
        local = SockaddrQrtr()
        ln = ctypes.c_uint32(ctypes.sizeof(local))
        if libc.getsockname(self.fd, ctypes.byref(local), ctypes.byref(ln)) != 0:
            sys.exit('getsockname failed')
        self.node = local.sq_node
        self.sendto(struct.pack('<IIIII', 10, DSD, 0, 0, 0), self.node, QRTR_PORT_CTRL)
        deadline = time.time() + 5
        self.addr = None
        while time.time() < deadline:
            data, _src = self.recv(deadline - time.time())
            if data is None:
                break
            cmd, svc, inst, node, port = struct.unpack_from('<IIIII', data)
            if cmd == 4 and svc == DSD and node == 0:
                self.addr = (node, port)
                break
            if cmd == 4 and svc == 0:
                break
        if not self.addr:
            sys.exit('DSD service not found')
        self.txn = 0

    def sendto(self, payload, node, port):
        dst = SockaddrQrtr(AF_QIPCRTR, node, port)
        buf = ctypes.create_string_buffer(payload, len(payload))
        if libc.sendto(self.fd, buf, len(payload), 0, ctypes.byref(dst), ctypes.sizeof(dst)) < 0:
            sys.exit('sendto failed: errno %d' % ctypes.get_errno())

    def recv(self, timeout):
        r, _, _ = select.select([self.fd], [], [], max(0.05, timeout))
        if not r:
            return None, None
        buf = ctypes.create_string_buffer(65536)
        src = SockaddrQrtr()
        ln = ctypes.c_uint32(ctypes.sizeof(src))
        n = libc.recvfrom(self.fd, buf, 65536, 0, ctypes.byref(src), ctypes.byref(ln))
        if n < 0:
            return None, None
        return buf.raw[:n], (src.sq_node, src.sq_port)

    def req(self, msg, payload=b''):
        self.txn += 1
        self.sendto(struct.pack('<BHHH', 0, self.txn, msg, len(payload)) + payload, *self.addr)
        deadline = time.time() + 5
        while time.time() < deadline:
            data, src = self.recv(deadline - time.time())
            if data is None:
                break
            flags, txn, mid, ln = struct.unpack_from('<BHHH', data)
            if src == self.addr and flags == 2 and txn == self.txn:
                t = parse_tlvs(data[7:7 + ln])
                res, err = struct.unpack('<HH', t.get(2, b'\0\0\0\0'))
                if res:
                    sys.exit('DSD 0x%04X: QMI error %d' % (msg, err))
                return t
        sys.exit('DSD 0x%04X: timeout' % msg)

    def get(self):
        t = self.req(0x004F)
        return struct.unpack('<I', t[0x10][:4])[0] if 0x10 in t else 0

    def set(self, sim):
        self.req(0x004E, struct.pack('<BHI', 0x01, 4, sim))
        deadline = time.time() + 10
        while time.time() < deadline:
            if self.get() == sim:
                return True
            time.sleep(0.5)
        return False


if __name__ == '__main__':
    if len(sys.argv) < 2 or sys.argv[1] not in ('get', 'set'):
        sys.exit('usage: m52xq-dds get | set 1|2')
    d = Dsd()
    if sys.argv[1] == 'get':
        print(d.get())
    else:
        want = int(sys.argv[2])
        sys.exit(0 if d.set(want) else 1)
