index 00000000..fe425249
--- /dev/null
+++ b/src/plugins/gstreamer/camerabin/m52xqautofocus.cpp
@@ -0,0 +1,298 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#include "m52xqautofocus.h"
+
+#include <gst/video/video.h>
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/ioctl.h>
+#include <linux/videodev2.h>
+
+#define AF_INFINITY 335     // factory calibration (EEPROM): 335 = infinity, 621 = macro
+#define AF_MACRO 621
+#define AF_SETTLE 3
+#define AF_COARSE 50
+#define AF_FINE 15
+#define AF_FINE_SPAN 40
+#define AF_LOW_RATIO 0.4
+#define AF_LOW_FRAMES 45
+#define AF_MEAN_CHANGE 0.6
+
+enum { AF_SETTLING, AF_SCANNING, AF_HOLDING };
+
+struct M52xqAf
+{
+    GMutex mutex;
+    bool tapPending;
+    double tapU, tapV;
+    int searching;      // atomic: read by the GUI thread
+    int fd, state, pos, cur, bestPos, fine, fineFrom, fineTo, settle, lowFrames, warned;
+    double bestScore, reference, refMean, roiU, roiV;
+};
+
+static const char *afKey = "m52xq-af";
+
+static int openLens()
+{
+    for (int i = 0; i < 64; ++i) {
+        char path[96], name[64] = "";
+        snprintf(path, sizeof(path), "/sys/class/video4linux/v4l-subdev%d/name", i);
+        FILE *f = fopen(path, "r");
+        if (!f)
+            continue;
+        const bool lens = fgets(name, sizeof(name), f) && !strncmp(name, "fp5529", 6);
+        fclose(f);
+        if (lens) {
+            snprintf(path, sizeof(path), "/dev/v4l-subdev%d", i);
+            return open(path, O_RDWR | O_CLOEXEC);
+        }
+    }
+    return -1;
+}
+
+static void setPos(M52xqAf *a, int pos)
+{
+    struct v4l2_control c;
+    memset(&c, 0, sizeof(c));
+    c.id = V4L2_CID_FOCUS_ABSOLUTE;
+    c.value = CLAMP(pos, 0, 1023);
+    if (ioctl(a->fd, VIDIOC_S_CTRL, &c) == 0)
+        a->cur = c.value;
+}
+
+static void moveTo(M52xqAf *a, int pos)
+{
+    a->pos = CLAMP(pos, AF_INFINITY, AF_MACRO);
+    setPos(a, a->pos);
+    a->settle = AF_SETTLE;
+    a->state = AF_SETTLING;
+    g_atomic_int_set(&a->searching, 1);
+}
+
+static void startSearch(M52xqAf *a)
+{
+    // the whole range from infinity to macro, then fine around the best position: a search that started at the last locked
+    // (near) position never got to far objects
+    a->fine = 0; a->bestScore = 0; a->lowFrames = 0;
+    a->bestPos = AF_INFINITY;
+    moveTo(a, AF_INFINITY);
+}
+
+static void finishSearch(M52xqAf *a, int pos)
+{
+    a->bestPos = CLAMP(pos, AF_INFINITY, AF_MACRO);
+    setPos(a, a->bestPos);
+    a->reference = 0;
+    a->settle = AF_SETTLE;
+    a->state = AF_HOLDING;
+    g_atomic_int_set(&a->searching, 0);
+    g_message("m52xq-af: locked at %d", a->bestPos);
+}
+
+static void evaluate(M52xqAf *a, double score)
+{
+    if (!a->fine) {
+        if (score > a->bestScore) {
+            a->bestScore = score; a->bestPos = a->pos;
+        }
+        if (a->pos < AF_MACRO) {
+            moveTo(a, MIN(a->pos + AF_COARSE, AF_MACRO));
+            return;
+        }
+        a->fine = 1;
+        a->fineFrom = MAX(a->bestPos - AF_FINE_SPAN, AF_INFINITY);
+        a->fineTo = MIN(a->bestPos + AF_FINE_SPAN, AF_MACRO);
+        a->bestScore = 0;
+        moveTo(a, a->fineFrom);
+        return;
+    }
+    if (score > a->bestScore) {
+        a->bestScore = score; a->bestPos = a->pos;
+    }
+    if (a->pos >= a->fineTo) {
+        finishSearch(a, a->bestPos);
+        return;
+    }
+    moveTo(a, MIN(a->pos + AF_FINE, a->fineTo));
+}
+
+// Gradient energy of 4x4 block averages of the luma plane in the region of interest. Large frames are sampled every k-th pixel (the
+// viewfinder of jolla-camera has the photo size).
+static double sharpness(M52xqAf *a, const guint8 *data, int stride, int width, int height, double *mean)
+{
+    *mean = 0;
+    const int k = MAX(1, width / 1280);
+    const int w = width / k, h = height / k;
+    if (w < 64 || h < 64)
+        return 0;
+    const bool tapped = a->roiU >= 0;
+    int rw = (tapped ? w / 5 : w * 2 / 5) & ~3, rh = (tapped ? h / 5 : h * 2 / 5) & ~3;
+    int x0 = tapped ? int(a->roiU * w) - rw / 2 : (w - rw) / 2;
+    int y0 = tapped ? int(a->roiV * h) - rh / 2 : (h - rh) / 2;
+    x0 = CLAMP(x0, 0, w - rw) & ~3;
+    y0 = CLAMP(y0, 0, h - rh) & ~3;
+    const int bw = rw / 4, bh = rh / 4;
+    float *blocks = g_new(float, gsize(bw) * bh);
+    double sum = 0;
+    for (int by = 0; by < bh; ++by)
+        for (int bx = 0; bx < bw; ++bx) {
+            int acc = 0;
+            for (int j = 0; j < 4; ++j) {
+                const guint8 *line = data + gsize((y0 + by * 4 + j) * k) * stride + gsize((x0 + bx * 4) * k);
+                acc += line[0] + line[k] + line[2 * k] + line[3 * k];
+            }
+            blocks[by * bw + bx] = acc / 16.0f;
+            sum += blocks[by * bw + bx];
+        }
+    const double m = sum / (double(bw) * bh);
+    double energy = 0;
+    for (int by = 0; by < bh - 1; ++by)
+        for (int bx = 0; bx < bw - 1; ++bx) {
+            const double gx = blocks[by * bw + bx + 1] - blocks[by * bw + bx];
+            const double gy = blocks[(by + 1) * bw + bx] - blocks[by * bw + bx];
+            energy += gx * gx + gy * gy;
+        }
+    g_free(blocks);
+    *mean = m;
+    return energy / (double(bw) * bh) / MAX(m * m, 1.0) * 1000.0;
+}
+
+static void process(M52xqAf *a, double score, double mean)
+{
+    if (a->settle > 0 && a->state != AF_SCANNING) {
+        if (--a->settle > 0)
+            return;
+        if (a->state == AF_SETTLING)
+            a->state = AF_SCANNING;
+    }
+    switch (a->state) {
+    case AF_SCANNING:
+        evaluate(a, score);
+        break;
+    case AF_HOLDING:
+        if (a->reference <= 0) {
+            a->reference = score; a->refMean = mean; a->lowFrames = 0;
+            break;
+        }
+        if (score < a->reference * AF_LOW_RATIO || fabs(mean - a->refMean) > a->refMean * AF_MEAN_CHANGE) {
+            if (++a->lowFrames >= AF_LOW_FRAMES)
+                startSearch(a);
+        } else {
+            a->lowFrames = 0;
+        }
+        break;
+    default:
+        break;
+    }
+}
+
+static GstPadProbeReturn probe(GstPad *pad, GstPadProbeInfo *info, gpointer data)
+{
+    M52xqAf *a = static_cast<M52xqAf *>(data);
+    GstBuffer *buffer = GST_PAD_PROBE_INFO_BUFFER(info);
+    if (!buffer)
+        return GST_PAD_PROBE_OK;
+
+    g_mutex_lock(&a->mutex);
+    const bool tapped = a->tapPending;
+    if (tapped) {
+        a->roiU = a->tapU; a->roiV = a->tapV;
+        a->tapPending = false;
+    }
+    g_mutex_unlock(&a->mutex);
+    if (tapped)
+        startSearch(a);
+
+    if (a->settle > 1 && a->state == AF_SETTLING) {
+        a->settle--;
+        return GST_PAD_PROBE_OK;
+    }
+
+    GstCaps *caps = gst_pad_get_current_caps(pad);
+    if (!caps)
+        return GST_PAD_PROBE_OK;
+    GstVideoInfo vi;
+    const bool ok = gst_video_info_from_caps(&vi, caps);
+    gst_caps_unref(caps);
+    const GstVideoFormat format = ok ? GST_VIDEO_INFO_FORMAT(&vi) : GST_VIDEO_FORMAT_UNKNOWN;
+    if (format != GST_VIDEO_FORMAT_NV12 && format != GST_VIDEO_FORMAT_NV21) {
+        if (!a->warned) {
+            a->warned = 1;
+            g_message("m52xq-af: frame format not supported, no autofocus");
+            g_atomic_int_set(&a->searching, 0);
+        }
+        return GST_PAD_PROBE_OK;
+    }
+
+    GstMapInfo map;
+    if (!gst_buffer_map(buffer, &map, GST_MAP_READ))
+        return GST_PAD_PROBE_OK;
+    GstVideoMeta *meta = gst_buffer_get_video_meta(buffer);
+    const int w = GST_VIDEO_INFO_WIDTH(&vi), h = GST_VIDEO_INFO_HEIGHT(&vi);
+    const int stride = meta ? meta->stride[0] : GST_VIDEO_INFO_PLANE_STRIDE(&vi, 0);
+    const gsize offset = meta ? meta->offset[0] : 0;
+    if (offset + gsize(stride) * h <= map.size) {
+        double mean;
+        const double score = sharpness(a, map.data + offset, stride, w, h, &mean);
+        process(a, score, mean);
+    }
+    gst_buffer_unmap(buffer, &map);
+    return GST_PAD_PROBE_OK;
+}
+
+static void freeAf(gpointer data)
+{
+    M52xqAf *a = static_cast<M52xqAf *>(data);
+    if (a->fd >= 0)
+        close(a->fd);
+    g_mutex_clear(&a->mutex);
+    g_free(a);
+}
+
+M52xqAf *m52xq_af_get(GstElement *videoSource)
+{
+    return videoSource ? static_cast<M52xqAf *>(g_object_get_data(G_OBJECT(videoSource), afKey)) : 0;
+}
+
+M52xqAf *m52xq_af_attach(GstElement *videoSource)
+{
+    if (M52xqAf *a = m52xq_af_get(videoSource))
+        return a;
+    if (!videoSource)
+        return 0;
+    const int fd = openLens();
+    if (fd < 0)
+        return 0;
+    GstPad *pad = gst_element_get_static_pad(videoSource, "src");
+    if (!pad) {
+        close(fd);
+        return 0;
+    }
+    M52xqAf *a = g_new0(M52xqAf, 1);
+    g_mutex_init(&a->mutex);
+    a->fd = fd;
+    a->roiU = a->roiV = -1;
+    startSearch(a);
+    // the struct lives as long as the element (the probe is removed with its pad)
+    g_object_set_data_full(G_OBJECT(videoSource), afKey, a, freeAf);
+    gst_pad_add_probe(pad, GST_PAD_PROBE_TYPE_BUFFER, probe, a, NULL);
+    gst_object_unref(pad);
+    g_message("m52xq-af: lens found, autofocus on");
+    return a;
+}
+
+void m52xq_af_tap(M52xqAf *a, double u, double v)
+{
+    g_mutex_lock(&a->mutex);
+    a->tapU = u; a->tapV = v;
+    a->tapPending = true;
+    g_mutex_unlock(&a->mutex);
+    g_atomic_int_set(&a->searching, 1);
+}
+
+bool m52xq_af_searching(M52xqAf *a)
+{
+    return g_atomic_int_get(&a->searching) != 0;
+}
diff --git a/src/plugins/gstreamer/camerabin/m52xqautofocus.h b/src/plugins/gstreamer/camerabin/m52xqautofocus.h
new file mode 100644
index 00000000..2ac4e7d2
--- /dev/null
+++ b/src/plugins/gstreamer/camerabin/m52xqautofocus.h
@@ -0,0 +1,18 @@
+// M52XQ (Galaxy M52): software autofocus of the main camera (s5kgw3, voice coil lens fp5529) on the frames of libcamerasrc.
+// Port of m52xqcamsrc of our Ubuntu Touch port (LensAutofocus of our plasma-camera build): contrast search.
+#ifndef M52XQAUTOFOCUS_H
+#define M52XQAUTOFOCUS_H
+
+#include <gst/gst.h>
+
+struct M52xqAf;
+
+// Attaches the autofocus to the video source (once per element); 0 when there is no lens
+M52xqAf *m52xq_af_attach(GstElement *videoSource);
+M52xqAf *m52xq_af_get(GstElement *videoSource);
+// Starts a search around the point (0..1 of the frame), u < 0: the middle
+void m52xq_af_tap(M52xqAf *af, double u, double v);
+// true while the search runs, false when the lens holds a position
+bool m52xq_af_searching(M52xqAf *af);
+
+#endif
diff --git a/src/plugins/gstreamer/camerabin/m52xqzoom.cpp b/src/plugins/gstreamer/camerabin/m52xqzoom.cpp
new file mode 100644
index 00000000..18f52420
--- /dev/null
+++ b/src/plugins/gstreamer/camerabin/m52xqzoom.cpp
@@ -0,0 +1,96 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#include "m52xqzoom.h"
+
+#include <gst/video/video.h>
+#include <string.h>
+
+static gint zoomPercent = 100;      // atomic, survives a new source
+static const char *zoomKey = "m52xq-zoom";
+
+double m52xq_zoom_get()
+{
+    return g_atomic_int_get(&zoomPercent) / 100.0;
+}
+
+// middle 1/z of the plane scaled up, nearest neighbour; pixels of "bytes" bytes
+static void scalePlane(const guint8 *src, int srcStride, guint8 *dst, int dstStride, int w, int h, double z, int bytes)
+{
+    const int cw = MAX(1, int(w / z)), ch = MAX(1, int(h / z));
+    const int x0 = (w - cw) / 2, y0 = (h - ch) / 2;
+    gint *xs = g_new(gint, w);
+    for (int x = 0; x < w; ++x)
+        xs[x] = x0 + int(gint64(x) * cw / w);
+    int lastY = -1;
+    for (int y = 0; y < h; ++y) {
+        const int sy = y0 + int(gint64(y) * ch / h);
+        guint8 *out = dst + gsize(y) * dstStride;
+        if (sy == lastY) {
+            memcpy(out, out - dstStride, gsize(w) * bytes);
+            continue;
+        }
+        lastY = sy;
+        const guint8 *in = src + gsize(sy) * srcStride;
+        if (bytes == 1) {
+            for (int x = 0; x < w; ++x)
+                out[x] = in[xs[x]];
+        } else {
+            const guint16 *in16 = reinterpret_cast<const guint16 *>(in);
+            guint16 *out16 = reinterpret_cast<guint16 *>(out);
+            for (int x = 0; x < w; ++x)
+                out16[x] = in16[xs[x]];
+        }
+    }
+    g_free(xs);
+}
+
+static GstPadProbeReturn probe(GstPad *pad, GstPadProbeInfo *info, gpointer)
+{
+    const double z = m52xq_zoom_get();
+    GstBuffer *in = GST_PAD_PROBE_INFO_BUFFER(info);
+    if (!in || z < 1.01)
+        return GST_PAD_PROBE_OK;
+    GstCaps *caps = gst_pad_get_current_caps(pad);
+    if (!caps)
+        return GST_PAD_PROBE_OK;
+    GstVideoInfo vi;
+    const bool ok = gst_video_info_from_caps(&vi, caps);
+    gst_caps_unref(caps);
+    if (!ok || (GST_VIDEO_INFO_FORMAT(&vi) != GST_VIDEO_FORMAT_NV12
+                && GST_VIDEO_INFO_FORMAT(&vi) != GST_VIDEO_FORMAT_NV21))
+        return GST_PAD_PROBE_OK;
+
+    GstVideoFrame src, dst;
+    if (!gst_video_frame_map(&src, &vi, in, GST_MAP_READ))
+        return GST_PAD_PROBE_OK;
+    GstBuffer *out = gst_buffer_new_allocate(NULL, GST_VIDEO_INFO_SIZE(&vi), NULL);
+    if (!out || !gst_video_frame_map(&dst, &vi, out, GST_MAP_WRITE)) {
+        if (out)
+            gst_buffer_unref(out);
+        gst_video_frame_unmap(&src);
+        return GST_PAD_PROBE_OK;
+    }
+    const int w = GST_VIDEO_INFO_WIDTH(&vi), h = GST_VIDEO_INFO_HEIGHT(&vi);
+    scalePlane(static_cast<const guint8 *>(GST_VIDEO_FRAME_PLANE_DATA(&src, 0)), GST_VIDEO_FRAME_PLANE_STRIDE(&src, 0),
+               static_cast<guint8 *>(GST_VIDEO_FRAME_PLANE_DATA(&dst, 0)), GST_VIDEO_FRAME_PLANE_STRIDE(&dst, 0), w, h, z, 1);
+    scalePlane(static_cast<const guint8 *>(GST_VIDEO_FRAME_PLANE_DATA(&src, 1)), GST_VIDEO_FRAME_PLANE_STRIDE(&src, 1),
+               static_cast<guint8 *>(GST_VIDEO_FRAME_PLANE_DATA(&dst, 1)), GST_VIDEO_FRAME_PLANE_STRIDE(&dst, 1), w / 2, h / 2, z, 2);
+    gst_video_frame_unmap(&dst);
+    gst_video_frame_unmap(&src);
+    gst_buffer_copy_into(out, in, GstBufferCopyFlags(GST_BUFFER_COPY_FLAGS | GST_BUFFER_COPY_TIMESTAMPS), 0, -1);
+    gst_buffer_unref(in);
+    GST_PAD_PROBE_INFO_DATA(info) = out;
+    return GST_PAD_PROBE_OK;
+}
+
+void m52xq_zoom_set(GstElement *videoSource, double factor)
+{
+    g_atomic_int_set(&zoomPercent, int(CLAMP(factor, 1.0, M52XQ_ZOOM_MAX) * 100 + 0.5));
+    if (!videoSource || factor < 1.01 || g_object_get_data(G_OBJECT(videoSource), zoomKey))
+        return;
+    GstPad *pad = gst_element_get_static_pad(videoSource, "src");
+    if (!pad)
+        return;
+    gst_pad_add_probe(pad, GST_PAD_PROBE_TYPE_BUFFER, probe, NULL, NULL);
+    g_object_set_data(G_OBJECT(videoSource), zoomKey, GINT_TO_POINTER(1));
+    gst_object_unref(pad);
+}
