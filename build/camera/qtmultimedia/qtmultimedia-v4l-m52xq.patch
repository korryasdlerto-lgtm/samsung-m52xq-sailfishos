+void CameraBinImageCapture::captureRaw(const QString &fileName)
+{
+    const int id = m_requestId;
+    const QString file = m_session->rawPhotoFileName(fileName);
+    // written under a temporary name: the gallery opened the file while it was still being written
+    const QString part = QFileInfo(file).path() + QLatin1String("/.") + QFileInfo(file).fileName() + QLatin1String(".part");
+    const bool front = m_session->device().contains(QLatin1String("imx616"));
+    const int orientation = m_session->rawPhotoExifOrientation();
